rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'qaz73700@gmail.com';
    }
    function validTag(tags, index) {
      return tags.size() <= index || (tags[index] is string && tags[index].size() > 0 && tags[index].size() <= 40);
    }
    match /users/{uid}/contacts/{contactId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','intro','birthday','company','title','category','color','strength','lastContact','notes','focus','followup','email','phone','address','sns','metAt','registeredOn','relationship','tags','archived','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && (!('intro' in request.resource.data) || (request.resource.data.intro is string && request.resource.data.intro.size() <= 200))
        && (!('birthday' in request.resource.data) || (request.resource.data.birthday is string && request.resource.data.birthday.matches('^([0-9]{4}-|--)[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.company is string && request.resource.data.company.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
        && (!('color' in request.resource.data) || request.resource.data.color == '' || request.resource.data.color.matches('^#[0-9a-fA-F]{6}$'))
        && request.resource.data.strength is int && request.resource.data.strength >= 1 && request.resource.data.strength <= 5
        && request.resource.data.lastContact is string && request.resource.data.lastContact.size() <= 10
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 4000
        && request.resource.data.focus is string && request.resource.data.focus.size() <= 1000
        && request.resource.data.followup is string && request.resource.data.followup.size() <= 1000
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 100
        && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 500))
        && (!('sns' in request.resource.data) || (request.resource.data.sns is string && request.resource.data.sns.size() <= 500))
        && (!('metAt' in request.resource.data) || (request.resource.data.metAt is string && request.resource.data.metAt.size() <= 300))
        && (!('registeredOn' in request.resource.data) || (request.resource.data.registeredOn is string && request.resource.data.registeredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('relationship' in request.resource.data) || request.resource.data.relationship in ['멘토','대표','투자','지인','친구'])
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 20 && request.resource.data.tags.toSet().size() == request.resource.data.tags.size() && validTag(request.resource.data.tags, 0) && validTag(request.resource.data.tags, 1) && validTag(request.resource.data.tags, 2) && validTag(request.resource.data.tags, 3) && validTag(request.resource.data.tags, 4) && validTag(request.resource.data.tags, 5) && validTag(request.resource.data.tags, 6) && validTag(request.resource.data.tags, 7) && validTag(request.resource.data.tags, 8) && validTag(request.resource.data.tags, 9) && validTag(request.resource.data.tags, 10) && validTag(request.resource.data.tags, 11) && validTag(request.resource.data.tags, 12) && validTag(request.resource.data.tags, 13) && validTag(request.resource.data.tags, 14) && validTag(request.resource.data.tags, 15) && validTag(request.resource.data.tags, 16) && validTag(request.resource.data.tags, 17) && validTag(request.resource.data.tags, 18) && validTag(request.resource.data.tags, 19)))
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/tasks/{taskId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['eventId','label','done','updatedAt'])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() <= 1024
        && request.resource.data.label is string && request.resource.data.label.size() <= 1000
        && request.resource.data.done is bool && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/categories/{categoryId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','color','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.name != '전체'
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/todos/{todoId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['date','text','done','archived','createdAt','order','updatedAt'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.done is bool && request.resource.data.archived is bool
        && request.resource.data.createdAt is int
        && (!('order' in request.resource.data) || (request.resource.data.order is int && request.resource.data.order >= 0))
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/dailyNotes/{date} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['text','updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 10000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/conversations/{entryId} {
      allow delete: if owner(uid);
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['contactId','date','text','createdAt','updatedAt'])
        && request.resource.data.contactId is string && request.resource.data.contactId.size() <= 200
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/documents/{documentId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['title','filename','date','contactId','source','storagePath','driveFileId','driveViewLink','mime','size','content','sourceIds','createdAt','archived','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 180
        && request.resource.data.filename is string && request.resource.data.filename.size() > 0 && request.resource.data.filename.size() <= 180
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.contactId is string && request.resource.data.contactId.size() <= 200
        && request.resource.data.source in ['upload','generated','note']
        && request.resource.data.storagePath == ''
        && request.resource.data.driveFileId is string && request.resource.data.driveFileId.matches('^[-a-zA-Z0-9_]{10,200}$')
        && request.resource.data.driveViewLink is string && request.resource.data.driveViewLink.size() <= 1000 && request.resource.data.driveViewLink.matches('^https://drive[.]google[.]com/.*$')
        && request.resource.data.mime is string && request.resource.data.mime.size() <= 150
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 20971520
        && request.resource.data.content is string && request.resource.data.content.size() <= 100000
        && request.resource.data.sourceIds is list && request.resource.data.sourceIds.size() <= 6
        && request.resource.data.createdAt is int && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;
    }
  }
}
